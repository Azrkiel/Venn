# Copy to .env.local. Never commit the filled file.
APP_BASE_URL=http://localhost:3000
# Auth.js callback origin. Use localhost, not 127.0.0.1: Next normalizes loopback hosts to localhost.
AUTH_URL=http://localhost:3000

# Postgres: pooled runtime connection; optional direct connection for migrations.
DATABASE_URL=
DIRECT_URL=

# Google identity login. AUTH_SECRET is a random secret, not a Google credential.
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Microsoft identity and Outlook Calendar: register a Web application supporting
# both personal Microsoft accounts and work/school accounts. Redirect URIs:
# http://localhost:3000/api/auth/callback/microsoft-entra-id (identity only)
# http://localhost:3000/api/calendar/outlook/callback (separate calendar consent)
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
# Outlook consent requests delegated Calendars.ReadBasic and offline_access.
# Apple iCloud needs no developer client: users supply an app-specific password.

# Calendar can reuse the same Google OAuth client registration.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:3000/api/calendar/callback

# A base64-encoded 32-byte key for server-side AES-GCM grant encryption.
TOKEN_ENCRYPTION_KEY=

# Gemini is separate from Calendar OAuth. No model key goes in browser code.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Photon cloud DM transport. Local mode would require a Mac and is disabled.
IMESSAGE_LOCAL=false
IMESSAGE_PROJECT_ID=
IMESSAGE_PROJECT_SECRET=
IMESSAGE_WEBHOOK_SECRET=

# Only needed when deploying the explicit expiry-maintenance endpoint.
CRON_SECRET=
